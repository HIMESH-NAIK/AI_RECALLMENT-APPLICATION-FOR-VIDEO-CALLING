# ==============================================================================
# Local AI Agent + Self-Hosted Hindsight Memory Configuration
# ==============================================================================

# Hindsight Persistent Memory Settings
# Self-hosted local Hindsight instance URL (Default: http://localhost:8888)
HINDSIGHT_URL=http://localhost:8888

# Hindsight API key (Optional for local self-hosted instance, keep blank if disabled)
HINDSIGHT_API_KEY=

# Used by the local Hindsight container when calling its configured LLM provider.
# Use a secret value for authenticated providers; Ollama's local compatibility key may be "ollama".
HINDSIGHT_API_LLM_API_KEY=ollama

# Default memory bank namespace for the agent
HINDSIGHT_DEFAULT_BANK=hackathon_agent

# LLM Provider Configuration
# Supported options: 'ollama', 'openai_compatible', 'mock_dev'
LLM_PROVIDER=ollama

# Model name to use (e.g., llama3.2, mistral, llama3, qwen2.5:3b, etc.)
LLM_MODEL=llama3.2

# Ollama Settings (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Generic OpenAI-compatible Settings (when LLM_PROVIDER=openai_compatible)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# Request timeout in seconds for LLM calls
LLM_TIMEOUT_SECONDS=180
HINDSIGHT_TIMEOUT_SECONDS=300

# Browser frontend origin allowed by FastAPI CORS (comma-separated origins supported)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# FastAPI Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# Deployment platforms can provide PORT; it takes precedence over APP_PORT.

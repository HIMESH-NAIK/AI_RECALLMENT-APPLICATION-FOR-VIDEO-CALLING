# ==============================================================================
# Local AI Agent + Self-Hosted Hindsight Memory Configuration
# ==============================================================================

# Hindsight Persistent Memory Settings
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_DEFAULT_BANK=hackathon_agent

# LLM Provider Configuration ('ollama', 'openai_compatible', 'mock_dev')
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Generic OpenAI-compatible Settings
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# LLM Request timeout in seconds
LLM_TIMEOUT_SECONDS=180

# FastAPI Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
FRONTEND_URL=http://localhost:5173,http://localhost:5174
